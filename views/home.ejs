<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <title>Kaera's Portfolio</title>
</head>
<body>
    <div>
      <nav class="navbar navbar-expand">
        <div class="container-fluid">
          <a class="navbar-brand" href="/home">
            <img src="/images/logo.png" style="width:60px; height: auto;" alt="Logo">
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse justify-content-end" id="collapsibleNavbar">
            <ul class="navbar-nav">
                <li class="nav-item">
                  <a class="nav-link" href="/home">Home</a>
                </li> 
                <li class="nav-item">
                  <a class="nav-link" href="/portfolio">Portfolio</a>
                </li> 
                <li class="nav-item">
                  <a class="nav-link" href="/about">About</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/contact">Contact</a>
                </li>
              </ul>
            </div>
        </div>
      </nav>
    </div>
    <br>

    <div class="outer-container">
      <div class="rounded-container">
        <div class="home-hero">
          <h1>Hello, I'm Kaera Barber</h1>
          <p>Welcome to my portfolio!</p>
          <p>I am a Year 2 student exploring digital design and development. Through my school projects I have applied my knowledge of web technologies and tools.</p>
          <p>Feel free to browse through my portfolio and explore the work I've done.</p>
        </div>
        <br>
        <hr style="border: none; height: 2px; background: linear-gradient(90deg, transparent, #d4a574, transparent); margin: 50px 0;">
        <br>
        <div>
          <a href="/portfolio" class="home-section-link" style="text-decoration: none;">
            <div>
              <h2 style="margin-bottom: 10px;">Portfolio</h2>
              <p style="margin: 0; color: #666;">Click to explore my past works!</p>
            </div>
          </a>
        </div>
        <br>
        
        <div style="text-align:right">
          <a href="/about" class="home-section-link" style="text-decoration: none;">
            <div>
              <h2 style="margin-bottom: 10px;">About</h2>
              <p style="margin: 0; color: #666;">Click to learn more about me!</p>
            </div>
          </a>
        </div>
        <br>
        
        <div>
          <a href="/contact" class="home-section-link" style="text-decoration: none;">
            <div>
              <h2 style="margin-bottom: 10px;">Contact</h2>
              <p style="margin: 0; color: #666;">Click to know how to reach me!</p>
            </div>
          </a>
        </div>
      </div>
